# mogause Backend Environment Configuration
# Copy this file to .env and update with your values

# ═══════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════

PORT=4002
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ═══════════════════════════════════════════════════════════════
# 0G Galileo Network Configuration
# ═══════════════════════════════════════════════════════════════

# Network details for 0G Galileo Testnet
STELLAR_NETWORK=stellar:testnet
NETWORK_NAME=0G-Galileo-Testnet
CHAIN_ID=16602
TOKEN_SYMBOL=0G
BLOCK_EXPLORER=https://chainscan-galileo.0g.ai
HORIZON_URL=https://chainscan-galileo.0g.ai
# When unset, the server checks the configured explorer endpoint before attaching transaction links to payment logs.
# SKIP_HORIZON_TX_VERIFY=true

EXPLORER_BASE=https://chainscan-galileo.0g.ai

# Charge recipient address for payment settlement (preferred key name)
CHARGE_RECIPIENT=G...

# Legacy alias (still supported)
# SERVER_ADDRESS=G...

# The private key of the backend agent wallet (MPP shared secret for charge verification)
# Set either AGENT_PRIVATE_KEY or MPP_SECRET_KEY — both are accepted.
AGENT_PRIVATE_KEY=S...
# MPP_SECRET_KEY=

# Additional aliases for charge recipient (all supported)
# MPP_RECIPIENT=G...
# STELLAR_RECIPIENT=G...

# ═══════════════════════════════════════════════════════════════
# AI Model Configuration
# ═══════════════════════════════════════════════════════════════

# Groq API Key (Llama 3.3)
GROQ_API_KEY=

# Google Gemini API Key (Fallback)
GEMINI_API_KEY=

# ═══════════════════════════════════════════════════════════════
# Agent Onboarding & Sponsorship (Sponsor Service)
# ═══════════════════════════════════════════════════════════════

# Sponsor account secret key (usually same as AGENT_PRIVATE_KEY for simple setups)
SPONSOR_SECRET_KEY=

# Comma-separated channel account keys for concurrency
CHANNEL_SECRET_KEYS=S...,S...,S...

# Primary gas token symbol
USDC_ISSUER=0G

# Max transaction fee units (network-specific)
MAX_TX_FEE=10000

# Max starting balance for new agents in stroops
MAX_STARTING_BALANCE=1

# TTL for unredeemed /create responses (30s)
CHANNEL_RESERVATION_TTL_MS=30000

# ═══════════════════════════════════════════════════════════════
# Operational Settings
# ═══════════════════════════════════════════════════════════════

# Simulation Mode: true = bypass real payments, false = require on-chain payments
SIMULATION_MODE=false

# Set true only to re-enable legacy Stellar MPP / mppx (HTTP 402 + S... G... keys). Default: 0G EVM rail (no MPP 402).
# USE_STELLAR_MPP=false

# IP Rate limiting for onboarding
RATE_LIMIT_PER_IP_WINDOW_MS=3600000
RATE_LIMIT_PER_IP_MAX=5

# Contract Address for 0G-Galileo-Testnet Agent Registry (EVM)
CONTRACT_ADDRESS=0xe27bCA717aA803dBc1AB3989a915507ddfbbFb4D

# EVM JSON-RPC (used to read AgentRegistry: logs + getAgent)
EVM_RPC_URL=https://evmrpc-testnet.0g.ai
# Block to start scanning for AgentRegistered (set to your deployment block to save RPC time)
AGENT_REGISTRY_FROM_BLOCK=0
# Set false to disable on-chain index reads (faster local dev)
EVM_REGISTRY_SYNC=true

# Optional: emit real on-chain A2A settlement txs on 0G testnet for payment logs
# (when false, A2A rows use simulated local ids)
EVM_SETTLEMENT_ENABLED=false
# When true, backend throws instead of falling back to simulated A2A ids.
EVM_SETTLEMENT_REQUIRED=false
# Sender key for on-chain A2A settlement txs (EVM hex private key)
EVM_SETTLEMENT_PRIVATE_KEY=0x...
# Receiver address for those settlement txs (treasury / sink)
EVM_SETTLEMENT_RECIPIENT=0x...

# ENS (Ethereum mainnet) — identity for agent wallets (.eth → address, reverse, text records)
# Uses a dedicated L1 RPC (not 0G). Set ENS_DISABLED=true to skip all ENS calls.
# ENS_ETH_RPC_URL=https://eth.llamarpc.com
# ENS_CACHE_TTL_MS=300000
# Bind this server's compute/settlement key to a name (forward must match env wallet address)
# ENS_AGENT_NAME=myagent.eth

# 0G Compute swarm orchestration (planner/researcher/critic/executor)
# Uses @0glabs/0g-serving-broker SDK directly.
ZG_COMPUTE_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_COMPUTE_PRIVATE_KEY=0x...
# Optional preferred provider/model. If empty, backend auto-selects first chatbot provider.
ZG_COMPUTE_PROVIDER_ADDRESS=
ZG_COMPUTE_MODEL=
# Route /api/agent/query via 0G swarm by default
ZG_SWARM_DEFAULT=false
ZG_COMPUTE_SERVICE_TYPE=chatbot
# Auto-funding for provider sub-account before requests.
ZG_COMPUTE_AUTO_FUND=true
ZG_COMPUTE_MIN_SUBACCOUNT_0G=1
ZG_COMPUTE_TOPUP_0G=1
# If ledger/account is missing, swarm bootstrap can initialize it.
# 0G broker requires >= 3 0G when creating a new ledger.
ZG_COMPUTE_BOOTSTRAP_DEPOSIT_0G=3
# Auto-run bootstrap in hybrid manager+swarm mode before coordinator pre-pass.
ZG_COMPUTE_AUTO_BOOTSTRAP=true

# Shared swarm memory on 0G Storage (optional; local file fallback remains enabled)
ZG_SHARED_MEMORY_ENABLED=false
# Turbo indexer endpoint for 0G Storage TS SDK
ZG_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
# Optional signer override for storage uploads (falls back to ZG_COMPUTE_PRIVATE_KEY)
# ZG_STORAGE_PRIVATE_KEY=0x...
# Optional bootstrap root hash for shared memory reads (if unset, backend uses data/swarm-memory.root.json)
# ZG_STORAGE_MEMORY_ROOT_HASH=

